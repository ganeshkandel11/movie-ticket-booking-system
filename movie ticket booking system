void initializeMovie(Movie *m) {
    if (m == NULL) return;
    
    int i, j;
    for (i = 0; i < MAX_SEATS; i++) {
        for (j = 0; j < MAX_SEATS; j++) {
            m->seat[i][j] = 0;
        }
    }
    
    for (i = 0; i < MAX_CUSTOMERS; i++) {
        strcpy(m->customername[i], "");
    }
    
    m->basic = 0;
    m->mid = 0;
    m->special = 0;
    m->moviestatus = 1;
    m->totalSeats = MAX_SEATS * MAX_SEATS;
    m->bookedSeats = 0;
    m->priceBasic = 150.0;
    m->priceMid = 250.0;
    m->priceSpecial = 350.0;
    m->duration = 120;
    strcpy(m->genre, "General");
}

void inputMovieCode(Movie *m) {
    if (m == NULL) return;
    
    printf("Enter Movie ID: ");
    while (1) {
        if (scanf("%d", &m->moviecode) == 1) {
            if (m->moviecode > 0) {
                break;
            }
        }
        printf("Movie code must be positive! Re-enter: ");
        while (getchar() != '\n');
    }
}

void inputMovieData(Movie *m) {
    if (m == NULL) return;
    
    printf("Enter Movie Name: ");
    scanf(" %[^\n]", m->moviename);
    
    printf("Enter Movie Genre (Action, Comedy, Drama, etc.): ");
    scanf(" %[^\n]", m->genre);
    
    printf("Enter Movie Duration (minutes): ");
    m->duration = getValidInt(30, 300);
    
    printf("\nSelect Show Date:\n");
    displayAvailableDates();
    getDateFromUser(&m->year, &m->month, &m->day);
    
    if (isDateInPast(m->year, m->month, m->day)) {
        printf("\n[WARNING] This date is in the past!\n");
        printf("Do you want to continue? (1-Yes/0-No): ");
        if (getValidInt(0, 1) == 0) {
            inputMovieData(m);
            return;
        }
    }
    
    printf("\nSelect Show Timing:\n");
    displayShowTimings();
    printf("Enter show number (1-5): ");
    m->show = getValidInt(1, MAX_SHOWS);
    
    m->showID = generateShowID(m->moviecode, m->year, m->month, m->day, m->show);
    
    printf("\nEnter Basic Seat Price (Rs): ");
    m->priceBasic = getValidFloat(0, 9999);
    
    printf("Enter Mid Seat Price (Rs): ");
    m->priceMid = getValidFloat(0, 9999);
    
    printf("Enter Special Seat Price (Rs): ");
    m->priceSpecial = getValidFloat(0, 9999);
    
    initializeMovie(m);
}

int isMovieCodeDuplicate(int movieCode) {
    Movie temp;
    FILE *fp = fopen(FILE_NAME, "rb");
    
    if (fp == NULL) {
        return 0;
    }
    
    DataFileHeader header;
    if (fread(&header, sizeof(header), 1, fp) != 1 ||
        header.magic != DATA_FILE_MAGIC || header.version != MOVIE_DATA_VERSION) {
        fclose(fp);
        return 0;
    }
    
    while (fread(&temp, sizeof(Movie), 1, fp) == 1) {
        if (temp.moviecode == movieCode && temp.moviestatus == 1) {
            fclose(fp);
            return 1;
        }
    }
    
    fclose(fp);
    return 0;
}

int getMovieIndex(int movieCode, Movie movies[], int count) {
    if (movies == NULL) return -1;
    
    int i;
    for (i = 0; i < count; i++) {
        if (movies[i].moviecode == movieCode && movies[i].moviestatus == 1) {
            return i;
        }
    }
    return -1;
}

void addNewMovie(void) {
    Movie newMovie;
    Movie movies[MAX_MOVIES];
    int count = 0;
    int addAnother = 1;
    
    loadMovies(movies, &count);
    
    clearScreen();
    displayHeader("ADD NEW MOVIE");
    
    inputMovieCode(&newMovie);
    
    if (isMovieCodeDuplicate(newMovie.moviecode)) {
        printf("\n[ERROR] Movie ID already exists!\n");
        pressAnyKey();
        return;
    }
    
    do {
        inputMovieData(&newMovie);
        
        if (isShowDuplicate(newMovie.moviecode, newMovie.year, newMovie.month, 
                           newMovie.day, newMovie.show, movies, count)) {
            printf("\n[ERROR] This show already exists for this movie on this date!\n");
            printf("Do you want to add another show? (1-Yes/0-No): ");
            if (getValidInt(0, 1) == 1) {
                continue;
            } else {
                pressAnyKey();
                return;
            }
        }
        
        ensureMovieFileHeader();
        
        FILE *fp = fopen(FILE_NAME, "ab");
        if (fp == NULL) {
            printf("Error: Cannot open file!\n");
            pressAnyKey();
            return;
        }
        
        if (fwrite(&newMovie, sizeof(Movie), 1, fp) == 1) {
