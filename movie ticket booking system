void displayMovieShows(Movie movies[], int count, int movieCode) {
    int found = 0;
    printf("\n+----------------------------------------------------------------------------------------------+\n");
    printf("| #  | Movie Name          | Show       | Time       | Date       | Available | Status          |\n");
    printf("+----+---------------------+------------+------------+------------+-----------+-----------------|\n");
    
    int i;
    for (i = 0; i < count; i++) {
        if (movies[i].moviecode == movieCode && movies[i].moviestatus == 1) {
            char timeStr[20];
            char dateStr[20];
            char status[20];
            getShowTime(movies[i].show, timeStr);
            sprintf(dateStr, "%04d-%02d-%02d", movies[i].year, movies[i].month, movies[i].day);
            
            if (isBookingAllowed(&movies[i])) {
                strcpy(status, "Available");
            } else {
                strcpy(status, "Closed");
            }
            
            printf("| %-2d | %-19s | %-10s | %-10s | %-10s | %-9d | %-15s |\n",
                   found + 1, movies[i].moviename, getShowName(movies[i].show),
                   timeStr, dateStr, movies[i].totalSeats - movies[i].bookedSeats, status);
            found++;
        }
    }
    
    if (found == 0) {
        printf("| No shows found for this movie.                                                       |\n");
    }
    printf("+----------------------------------------------------------------------------------------------+\n");
}

