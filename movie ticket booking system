void loadMovies(Movie movies[], int *count) {
    if (movies == NULL || count == NULL) return;
    
    *count = 0;
    FILE *fp = fopen(FILE_NAME, "rb");
    
    if (fp == NULL) {
        return;
    }
    
    DataFileHeader header;
    if (fread(&header, sizeof(header), 1, fp) != 1 ||
        header.magic != DATA_FILE_MAGIC || header.version != MOVIE_DATA_VERSION) {
        fclose(fp);
        return;
    }
    
    while (*count < MAX_MOVIES && fread(&movies[*count], sizeof(Movie), 1, fp) == 1) {
        if (movies[*count].moviestatus == 1) {
            (*count)++;
        }
    }
    
    fclose(fp);
}

void saveMovies(Movie movies[], int count) {
    if (movies == NULL) return;
    
    FILE *fp = fopen(FILE_NAME, "wb");
    
    if (fp == NULL) {
        printf("Error: Cannot open file for saving!\n");
        return;
    }
    
    DataFileHeader header = { DATA_FILE_MAGIC, MOVIE_DATA_VERSION };
    fwrite(&header, sizeof(header), 1, fp);
    
    int savedCount = 0;
    int i;
    for (i = 0; i < count; i++) {
        if (movies[i].moviestatus == 1) {
            if (fwrite(&movies[i], sizeof(Movie), 1, fp) == 1) {
                savedCount++;
            }
        }
    }
    
    fclose(fp);
}

void loadBookings(Booking bookings[], int *count) {
