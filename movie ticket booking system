/* ---------- DATE & TIME FUNCTIONS ---------- */

void getCurrentDate(char *dateStr) {
    time_t t = time(NULL);
    struct tm *now = localtime(&t);
    sprintf(dateStr, "%04d-%02d-%02d", 
            now->tm_year + 1900, now->tm_mon + 1, now->tm_mday);
}

void getCurrentDateTime(char *dateTimeStr) {
    time_t t = time(NULL);
    struct tm *now = localtime(&t);
    sprintf(dateTimeStr, "%04d-%02d-%02d %02d:%02d:%02d", 
            now->tm_year + 1900, now->tm_mon + 1, now->tm_mday,
            now->tm_hour, now->tm_min, now->tm_sec);
}

int isDateValid(int year, int month, int day) {
    if (year < 2024 || month < 1 || month > 12 || day < 1) return 0;
    
    int daysInMonth[] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
    
    // Check for leap year
    if ((year % 4 == 0 && year % 100 != 0) || (year % 400 == 0)) {
        daysInMonth[1] = 29;
    }
    
    return day <= daysInMonth[month - 1];
}

int isDateInPast(int year, int month, int day) {
    time_t t = time(NULL);
    struct tm *now = localtime(&t);
    
    if (year < now->tm_year + 1900) return 1;
    if (year > now->tm_year + 1900) return 0;
    if (month < now->tm_mon + 1) return 1;
    if (month > now->tm_mon + 1) return 0;
    return day < now->tm_mday;
}

int isDateToday(int year, int month, int day) {
    time_t t = time(NULL);
    struct tm *now = localtime(&t);
    return (year == now->tm_year + 1900 && 
            month == now->tm_mon + 1 && 
            day == now->tm_mday);
}

int getShowStartMinutes(int show) {
    switch(show) {
        case 1: return SHOW1_START;
        case 2: return SHOW2_START;
        case 3: return SHOW3_START;
        case 4: return SHOW4_START;
        case 5: return SHOW5_START;
        default: return -1;
    }
}

int isBookingAllowed(Movie *m) {
    if (m == NULL) return 0;
    
    // Check if show date is in the past
    if (isDateInPast(m->year, m->month, m->day)) {
        return 0;
    }
    
    // If show is today, check time
    if (isDateToday(m->year, m->month, m->day)) {
        time_t t = time(NULL);
        struct tm *now = localtime(&t);
        int currentMinutes = now->tm_hour * 60 + now->tm_min;
        int showStartMinutes = getShowStartMinutes(m->show);
        
        // Show hasn't started yet - booking allowed
        if (currentMinutes < showStartMinutes - BOOKING_CUTOFF_MINUTES) {
            return 1;
        }
        // Within cutoff period or show has started - booking not allowed
        return 0;
    }
    
    // Future date - booking allowed
    return 1;
}

char* getBookingBlockReason(Movie *m, char *buffer, int bufferSize) {
    if (m == NULL) {
        snprintf(buffer, bufferSize, "Invalid movie data");
        return buffer;
    }
    
    if (isDateInPast(m->year, m->month, m->day)) {
        snprintf(buffer, bufferSize, "This show has already passed (Date: %04d-%02d-%02d)",
                 m->year, m->month, m->day);
        return buffer;
    }
    
    if (isDateToday(m->year, m->month, m->day)) {
        time_t t = time(NULL);
        struct tm *now = localtime(&t);
        int currentMinutes = now->tm_hour * 60 + now->tm_min;
        int showStartMinutes = getShowStartMinutes(m->show);
        char timeStr[20];
        getShowTime(m->show, timeStr);
        
        if (currentMinutes >= showStartMinutes) {
            snprintf(buffer, bufferSize, "Show has already started at %s", timeStr);
            return buffer;
        }
        
        if (currentMinutes >= showStartMinutes - BOOKING_CUTOFF_MINUTES) {
            int minutesLeft = (showStartMinutes - BOOKING_CUTOFF_MINUTES) - currentMinutes;
            if (minutesLeft <= 0) {
                snprintf(buffer, bufferSize, "Booking closed. Show starts at %s (cutoff %d min before)",
                         timeStr, BOOKING_CUTOFF_MINUTES);
            } else {
                snprintf(buffer, bufferSize, "Booking closes in %d minutes. Show starts at %s",
                         minutesLeft, timeStr);
            }
            return buffer;
        }
    }
    
    snprintf(buffer, bufferSize, "Booking allowed");
    return buffer;
}

void displayAvailableDates(void) {
    printf("\n+------------------------------------------------+\n");
    printf("| AVAILABLE SHOW DATES                          |\n");
    printf("+------------------------------------------------|\n");
    
    time_t t = time(NULL);
    struct tm *now = localtime(&t);
    int currentYear = now->tm_year + 1900;
    int currentMonth = now->tm_mon + 1;
    int currentDay = now->tm_mday;
    
    printf("| Date       | Day        | Status              |\n");
    printf("+------------+------------+---------------------|\n");
    
    // Show next 7 days
    int i;
    for (i = 0; i < 7; i++) {
        int year = currentYear;
        int month = currentMonth;
        int day = currentDay + i;
        
        // Adjust month/year if needed
        while (day > 31) {
            day -= 31;
            month++;
            if (month > 12) {
                month = 1;
                year++;
            }
        }
        
        // Get day of week
        struct tm date;
        memset(&date, 0, sizeof(date));
        date.tm_year = year - 1900;
        date.tm_mon = month - 1;
        date.tm_mday = day;
        mktime(&date);
        
        const char *days[] = {"Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"};
        
        printf("| %04d-%02d-%02d | %-10s | %-19s |\n", 
               year, month, day, days[date.tm_wday], "Available");
    }
    printf("+-----------------------------------------------+\n");
}

void getDateFromUser(int *year, int *month, int *day) {
    printf("\nEnter Show Date:\n");
    printf("Year (YYYY): ");
    while (scanf("%d", year) != 1 || *year < 2024) {
        printf("Invalid year! Enter a valid year (>= 2024): ");
        while (getchar() != '\n');
    }
    
    printf("Month (1-12): ");
    *month = getValidInt(1, 12);
    
    printf("Day (1-31): ");
    *day = getValidInt(1, 31);
    
    while (!isDateValid(*year, *month, *day)) {
        printf("Invalid date! Please enter a valid date.\n");
        printf("Year (YYYY): ");
        while (scanf("%d", year) != 1 || *year < 2024) {
            printf("Invalid year! Enter a valid year (>= 2024): ");
            while (getchar() != '\n');
        }
        printf("Month (1-12): ");
        *month = getValidInt(1, 12);
        printf("Day (1-31): ");
        *day = getValidInt(1, 31);
    }
}

