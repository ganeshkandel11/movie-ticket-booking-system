int getNextBookingID(void) {
    Booking temp;
    int maxID = 0;
    FILE *fp = fopen(TICKET_FILE, "rb");
    
    if (fp == NULL) {
        return 1;
    }
    
    DataFileHeader header;
    if (fread(&header, sizeof(header), 1, fp) != 1 ||
        header.magic != DATA_FILE_MAGIC || header.version != BOOKING_DATA_VERSION) {
        fclose(fp);
        return 1;
    }
    
    while (fread(&temp, sizeof(Booking), 1, fp) == 1) {
        if (temp.bookingID > maxID) {
            maxID = temp.bookingID;
        }
    }
    
    fclose(fp);
    return maxID + 1;
}

