void bookTicket(void) {
    Movie movies[MAX_MOVIES];
    int count = 0;
    int movieCode;
    int showIndex = -1;
    int row, col, seatType;
    char customerName[MAX_NAME_LEN];
    Booking newBooking;
    int numTickets;
    int showSelection;
    int transactionID = 0;
    int ticketsSaved = 0;
    char blockReason[100];
    
    clearScreen();
    displayHeader("BOOK TICKET");
    
    loadMovies(movies, &count);
    
    if (count == 0) {
        printf("No movies available for booking.\n");
        pressAnyKey();
        return;
    }
    
    printf("Available Movies:\n");
    printf("+---------------------------------------+\n");
    printf("| #  | Movie Name          | Movie ID   |\n");
    printf("+----+---------------------+------------|\n");
    
    int uniqueMovies = 0;
    int movieCodes[MAX_MOVIES] = {0};
    int movieIndices[MAX_MOVIES] = {0};
    
    int i,j;
    for (i = 0; i < count; i++) {
        int alreadyAdded = 0;
        for (j = 0; j < uniqueMovies; j++) {
            if (movieCodes[j] == movies[i].moviecode) {
                alreadyAdded = 1;
                break;
            }
        }
        if (!alreadyAdded && movies[i].moviestatus == 1) {
            movieCodes[uniqueMovies] = movies[i].moviecode;
            movieIndices[uniqueMovies] = i;
            uniqueMovies++;
        }
    }
    
    for (i = 0; i < uniqueMovies; i++) {
        printf("| %-2d | %-19s | %-10d |\n", 
               i + 1, movies[movieIndices[i]].moviename, movies[movieIndices[i]].moviecode);
    }
    printf("+---------------------------------------+\n");
    
    printf("\nEnter Movie ID: ");
    while (scanf("%d", &movieCode) != 1 || movieCode < 0) {
        printf("Invalid input! Enter a positive number: ");
        while (getchar() != '\n');
    }
    
    printf("\nAvailable shows for this movie:\n");
    displayMovieShows(movies, count, movieCode);
    
    int showCount = 0;
    int showIndices[MAX_MOVIES];
    for (i = 0; i < count; i++) {
        if (movies[i].moviecode == movieCode && movies[i].moviestatus == 1) {
            if (!isDateInPast(movies[i].year, movies[i].month, movies[i].day) && 
                isBookingAllowed(&movies[i])) {
                showIndices[showCount++] = i;
            }
        }
    }
    
    if (showCount == 0) {
        printf("\n[INFO] No upcoming shows available for booking for this movie!\n");
        printf("       Shows may have already started or are fully booked.\n");
        pressAnyKey();
        return;
    }
    
    printf("\nSelect show (1-%d) - Only shows available for booking shown: ", showCount);
    showSelection = getValidInt(1, showCount);
    showIndex = showIndices[showSelection - 1];
    
    Movie *selectedMovie = &movies[showIndex];
    
    // Double-check booking allowed
    if (!isBookingAllowed(selectedMovie)) {
        getBookingBlockReason(selectedMovie, blockReason, sizeof(blockReason));
        printf("\n[ERROR] Booking not allowed for this show.\n");
        printf("Reason: %s\n", blockReason);
        pressAnyKey();
        return;
    }
    
    displaySeatLayout(selectedMovie);
    
    if (selectedMovie->bookedSeats >= selectedMovie->totalSeats) {
        printf("\n[INFO] Sorry, this show is fully booked!\n");
        pressAnyKey();
        return;
    }
    
    printf("How many tickets do you want to book? ");
    numTickets = getValidInt(1, selectedMovie->totalSeats - selectedMovie->bookedSeats);
    
    printf("\nEnter Customer Name: ");
    scanf(" %[^\n]", customerName);
    
    printf("\nSelect Seat Type:\n");
    printf("1. Basic (Rs %.2f)\n", selectedMovie->priceBasic);
    printf("2. Mid (Rs %.2f)\n", selectedMovie->priceMid);
    printf("3. Special (Rs %.2f)\n", selectedMovie->priceSpecial);
    printf("Enter choice: ");
    seatType = getValidInt(1, 3);
    
    float totalPrice = 0;
    int t;
    for (t = 0; t < numTickets; t++) {
        printf("\n--- Ticket %d of %d ---\n", t + 1, numTickets);
        printf("Select Seat (Row 1-10, Column 1-10):\n");
        printf("Enter row: ");
        row = getValidInt(1, MAX_SEATS) - 1;
        printf("Enter column: ");
        col = getValidInt(1, MAX_SEATS) - 1;
        
        if (selectedMovie->seat[row][col] == 1) {
            printf("\n[ERROR] Seat already booked! Try again.\n");
            t--;
            continue;
        }
        
        selectedMovie->seat[row][col] = 1;
        strcpy(selectedMovie->customername[selectedMovie->bookedSeats], customerName);
        selectedMovie->bookedSeats++;
        
        float seatPrice;
        switch(seatType) {
            case 1: seatPrice = selectedMovie->priceBasic; break;
            case 2: seatPrice = selectedMovie->priceMid; break;
            case 3: seatPrice = selectedMovie->priceSpecial; break;
            default: seatPrice = 0.0;
        }
        totalPrice += seatPrice;
        
        memset(&newBooking, 0, sizeof(Booking));
        strcpy(newBooking.customerName, customerName);
        newBooking.movieCode = movieCode;
        newBooking.show = selectedMovie->show;
        newBooking.showID = selectedMovie->showID;
        newBooking.seatRow = row + 1;
        newBooking.seatCol = col + 1;
        newBooking.seatType = seatType;
        newBooking.price = seatPrice;
        strcpy(newBooking.movieName, selectedMovie->moviename);
        newBooking.isCanceled = 0;
        
        char timeStr[20];
        getShowTime(selectedMovie->show, timeStr);
        strcpy(newBooking.showTime, timeStr);
        
        char dateStr[20];
        sprintf(dateStr, "%04d-%02d-%02d", selectedMovie->year, selectedMovie->month, selectedMovie->day);
        strcpy(newBooking.showDate, dateStr);
        
        getCurrentDateTime(newBooking.bookingDate);
        
        generateBookingID(&newBooking);
        
        if (ticketsSaved == 0) {
            transactionID = newBooking.bookingID;
        }
        newBooking.transactionID = transactionID;
        
        saveBooking(&newBooking);
        ticketsSaved++;
        
        printf("[OK] Ticket %d booked - Seat: Row %d, Column %d (Booking ID: %d, Transaction ID: %d)\n", 
               t + 1, row + 1, col + 1, newBooking.bookingID, transactionID);
    }
    
    saveMovies(movies, count);
    
    char timeStr[20];
    getShowTime(selectedMovie->show, timeStr);
    char dateStr[20];
    sprintf(dateStr, "%04d-%02d-%02d", selectedMovie->year, selectedMovie->month, selectedMovie->day);
    
    printf("\n========================================\n");
    printf("[OK] Booking Summary\n");
    printf("  Transaction ID: %d\n", transactionID);
    printf("  Customer: %s\n", customerName);
    printf("  Movie: %s\n", selectedMovie->moviename);
    printf("  Date: %s\n", dateStr);
    printf("  Show: %s (%s)\n", getShowName(selectedMovie->show), timeStr);
    printf("  Show ID: %d\n", selectedMovie->showID);
    printf("  Tickets Booked: %d\n", ticketsSaved);
    printf("  Total Price: Rs %.2f\n", totalPrice);
    printf("  Booking Date: %s\n", newBooking.bookingDate);
    printf("========================================\n");
    printf("\n[INFO] Please arrive at least 15 minutes before show time.\n");
    
    pressAnyKey();
}

void cancelTicket(void) {
    Movie movies[MAX_MOVIES];
    int count = 0;
    int bookingID;
    Booking bookings[MAX_BOOKINGS];
    int bookingCount = 0;
    int found = 0;
    int confirm;
    
    clearScreen();
    displayHeader("CANCEL TICKET");
    
    printf("Enter Booking ID to cancel: ");
    while (scanf("%d", &bookingID) != 1 || bookingID < 0) {
        printf("Invalid input! Enter a positive number: ");
        while (getchar() != '\n');
    }
    
    loadMovies(movies, &count);
    loadAllBookings(bookings, &bookingCount);
    
    int i;
    for (i = 0; i < bookingCount; i++) {
        if (bookings[i].bookingID == bookingID && bookings[i].isCanceled == 0) {
            found = 1;
            printf("\nBooking Found:\n");
            printf("+----------------------------------------------------+\n");
            printf("| Booking ID    : %-12d                           |\n", bookings[i].bookingID);
            printf("| Transaction ID: %-12d                           |\n", bookings[i].transactionID);
            printf("| Customer      : %-12s                           |\n", bookings[i].customerName);
            printf("| Movie         : %-12s                           |\n", bookings[i].movieName);
            printf("| Movie ID      : %-12d                           |\n", bookings[i].movieCode);
            printf("| Show ID       : %-12d                           |\n", bookings[i].showID);
            printf("| Date          : %-12s                           |\n", bookings[i].showDate);
            printf("| Show          : %-12s                           |\n", getShowName(bookings[i].show));
            printf("| Show Time     : %-12s                           |\n", bookings[i].showTime);
            printf("| Seat          : Row %d, Col %-6d                |\n", bookings[i].seatRow, bookings[i].seatCol);
            printf("| Price         : Rs %-10.2f                      |\n", bookings[i].price);
            printf("| Booking Date  : %-12s                           |\n", bookings[i].bookingDate);
            printf("+----------------------------------------------------+\n");
            
            int year, month, day;
            sscanf(bookings[i].showDate, "%d-%d-%d", &year, &month, &day);
            if (isDateInPast(year, month, day)) {
                printf("\n[WARNING] This show has already passed!\n");
                printf("Refund may not be available.\n");
            } else if (isDateToday(year, month, day)) {
                int showStart = getShowStartMinutes(bookings[i].show);
                time_t t = time(NULL);
                struct tm *now = localtime(&t);
                int currentMinutes = now->tm_hour * 60 + now->tm_min;
                if (currentMinutes >= showStart) {
                    printf("\n[WARNING] This show has already started!\n");
                    printf("Refund may not be available.\n");
                }
            }
            
            printf("\nCancel this booking? (1-Yes/0-No): ");
            confirm = getValidInt(0, 1);
            
            if (confirm == 1) {
                int movieIndex = -1, j;
                for (j = 0; j < count; j++) {
                    if (movies[j].showID == bookings[i].showID && movies[j].moviestatus == 1) {
                        movieIndex = j;
                        break;
                    }
                }
                
                if (movieIndex != -1) {
                    movies[movieIndex].seat[bookings[i].seatRow - 1][bookings[i].seatCol - 1] = 0;
                    movies[movieIndex].bookedSeats--;
                    saveMovies(movies, count);
                }
                
                bookings[i].isCanceled = 1;
                updateBookingFile(bookings, bookingCount);
                
                printf("\n[OK] Booking canceled successfully!\n");
            } else {
                printf("\nCancellation cancelled.\n");
            }
            break;
        }
    }
    
    if (!found) {
        printf("\n[ERROR] Booking ID %d not found or already canceled!\n", bookingID);
    }
    
    pressAnyKey();
}

