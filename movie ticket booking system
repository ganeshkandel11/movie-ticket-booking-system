void displayMyBookings(void) {
    Booking bookings[MAX_BOOKINGS];
    int count = 0;
    char customerName[MAX_NAME_LEN];
    int found = 0;
    float totalSpent = 0;
    int totalTickets = 0;
    
    clearScreen();
    displayHeader("MY BOOKINGS");
    
    printf("Enter your name to view your bookings: ");
    scanf(" %[^\n]", customerName);
    
    loadBookings(bookings, &count);
    
    if (count == 0) {
        printf("\nNo bookings found in the system.\n");
        pressAnyKey();
        return;
    }
    
    printf("\n+-------------------------------------------------------------------------------------------------------------------+\n");
    printf("| Booking ID | Movie               | Date       | Show       | Seat    | Price   | Status               | Cancellable |\n");
    printf("+------------+---------------------+------------+------------+---------+---------+----------------------+-------------|\n");
    
    int i;
    for (i = 0; i < count; i++) {
        if (bookings[i].isCanceled == 0 && 
            strcmp(bookings[i].customerName, customerName) == 0) {
            found = 1;
            char status[30];
            char cancellable[15];
            
            // Check if show has passed or started
            int year, month, day;
            sscanf(bookings[i].showDate, "%d-%d-%d", &year, &month, &day);
            
            int canCancel = 1;
            if (isDateInPast(year, month, day)) {
                strcpy(status, "Completed");
                canCancel = 0;
            } else if (isDateToday(year, month, day)) {
                int showStart = getShowStartMinutes(bookings[i].show);
                time_t t = time(NULL);
                struct tm *now = localtime(&t);
                int currentMinutes = now->tm_hour * 60 + now->tm_min;
                if (currentMinutes >= showStart) {
                    strcpy(status, "Started");
                    canCancel = 0;
                } else {
                    strcpy(status, "Upcoming");
                }
            } else {
                strcpy(status, "Upcoming");
            }
            
            strcpy(cancellable, canCancel ? "Yes" : "No");
            
            printf("| %-10d | %-19s | %-10s | %-10s | R%d C%-3d | Rs%-6.2f | %-20s | %-11s |\n",
                   bookings[i].bookingID, bookings[i].movieName,
                   bookings[i].showDate, bookings[i].showTime,
                   bookings[i].seatRow, bookings[i].seatCol,
                   bookings[i].price, status, cancellable);
            
            totalSpent += bookings[i].price;
            totalTickets++;
        }
    }
    
    if (!found) {
        printf("| No bookings found for customer: %-30s                             |\n", customerName);
    }
    
    printf("+-------------------------------------------------------------------------------------------------------------------+\n");
    
    if (found) {
        printf("\n+----------------------------------------------------+\n");
        printf("| SUMMARY FOR: %-31s |\n", customerName);
        printf("+----------------------------------------------------|\n");
        printf("| Total Tickets Booked : %-18d                |\n", totalTickets);
        printf("| Total Amount Spent   : Rs %-22.2f          |\n", totalSpent);
        printf("+----------------------------------------------------+\n");
        
        printf("\n[INFO] To cancel a booking, go to 'Cancel Ticket' option and enter the Booking ID.\n");
        printf("[NOTE] Bookings cannot be canceled after the show has started.\n");
    }
    
    pressAnyKey();
}

/* ---------- BOOKING HISTORY (ADMIN) ---------- */

void displayBookingHistory(void) {
    Booking bookings[MAX_BOOKINGS];
    int count = 0;
    float totalRevenue = 0;
    int totalTicketsSold = 0;
    int totalTransactions = 0;
    int processed[MAX_BOOKINGS] = {0};
    
    clearScreen();
    displayHeader("BOOKING HISTORY (ADMIN)");
    
    loadBookings(bookings, &count);
    
    if (count == 0) {
        printf("No active bookings found.\n");
        pressAnyKey();
        return;
    }
    
    printf("+---------------------------------------------------------------------------------------------------+\n");
    printf("| Txn ID | Customer    | Movie               | Date       | Show       | Seats            | Tickets | Total    |\n");
    printf("+--------+-------------+---------------------+------------+------------+------------------+---------+----------|\n");
    
    int i;
    for (i = 0; i < count; i++) {
        if (processed[i] || bookings[i].isCanceled == 1) {
            continue;
        }
        
        int transactionID = bookings[i].transactionID;
        char seatsList[512];
        seatsList[0] = '\0';
        float transactionTotal = 0;
        int ticketCount = 0;
        
        int j;
        for (j = i; j < count; j++) {
            if (!processed[j] && bookings[j].isCanceled == 0 && bookings[j].transactionID == transactionID) {
                char seatEntry[16];
                sprintf(seatEntry, "%sR%dC%d", ticketCount > 0 ? "," : "", bookings[j].seatRow, bookings[j].seatCol);
                
                if (strlen(seatsList) + strlen(seatEntry) < sizeof(seatsList) - 1) {
                    strcat(seatsList, seatEntry);
                }
                
                transactionTotal += bookings[j].price;
                ticketCount++;
                processed[j] = 1;
            }
        }
        
        printf("| %-6d | %-11s | %-19s | %-10s | %-10s | %-16s | %-7d | Rs%-7.2f |\n",
               transactionID, bookings[i].customerName, bookings[i].movieName,
               bookings[i].showDate, bookings[i].showTime,
               seatsList, ticketCount, transactionTotal);
        
        totalRevenue += transactionTotal;
        totalTicketsSold += ticketCount;
        totalTransactions++;
    }
    
    printf("+---------------------------------------------------------------------------------------------------+\n");
    printf("\n+----------------------------------------------------+\n");
    printf("| SUMMARY                                            |\n");
    printf("+----------------------------------------------------|\n");
    printf("| Total Transactions : %-10d                      |\n", totalTransactions);
    printf("| Total Tickets Sold : %-10d                      |\n", totalTicketsSold);
    printf("| Total Revenue      : Rs %-22.2f          |\n", totalRevenue);
    printf("+----------------------------------------------------+\n");
    
    pressAnyKey();
}

