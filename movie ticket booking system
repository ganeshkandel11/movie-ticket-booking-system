/* ---------- FILE OPERATIONS ---------- */

int ensureMovieFileHeader(void) {
    FILE *fp = fopen(FILE_NAME, "rb");
    
    if (fp == NULL) {
        fp = fopen(FILE_NAME, "wb");
        if (fp != NULL) {
            DataFileHeader header = { DATA_FILE_MAGIC, MOVIE_DATA_VERSION };
            fwrite(&header, sizeof(header), 1, fp);
            fclose(fp);
        }
        return 0;
    }
    
    DataFileHeader header;
    int valid = (fread(&header, sizeof(header), 1, fp) == 1 &&
                 header.magic == DATA_FILE_MAGIC &&
                 header.version == MOVIE_DATA_VERSION);
    fclose(fp);
    
    if (valid) {
        return 0;
    }
    
    remove("Movie_old_backup.dat");
    rename(FILE_NAME, "Movie_old_backup.dat");
    
    fp = fopen(FILE_NAME, "wb");
    if (fp != NULL) {
        DataFileHeader newHeader = { DATA_FILE_MAGIC, MOVIE_DATA_VERSION };
        fwrite(&newHeader, sizeof(newHeader), 1, fp);
        fclose(fp);
    }
    return 1;
}

