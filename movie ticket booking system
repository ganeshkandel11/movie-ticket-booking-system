        return;
    }
    
    while (*count < MAX_BOOKINGS && fread(&bookings[*count], sizeof(Booking), 1, fp) == 1) {
        (*count)++;
    }
    
    fclose(fp);
}

void saveBooking(Booking *b) {
    if (b == NULL) return;
    
    ensureBookingFileHeader();
    
    FILE *fp = fopen(TICKET_FILE, "ab");
    
    if (fp == NULL) {
        printf("Error: Cannot open ticket file!\n");
        return;
    }
    
    if (fwrite(b, sizeof(Booking), 1, fp) != 1) {
        printf("Error: Failed to save booking!\n");
    }
    
    fclose(fp);
}

void updateBookingFile(Booking bookings[], int count) {
    if (bookings == NULL) return;
    
    FILE *fp = fopen(TICKET_FILE, "wb");
    
    if (fp == NULL) {
        printf("Error: Cannot update booking file!\n");
        return;
    }
    
    DataFileHeader header = { DATA_FILE_MAGIC, BOOKING_DATA_VERSION };
    fwrite(&header, sizeof(header), 1, fp);
    
    int i;
    for (i = 0; i < count; i++) {
        fwrite(&bookings[i], sizeof(Booking), 1, fp);
    }
    
    fclose(fp);
}

