const char* getShowName(int show) {
    switch(show) {
        case 1: return "Morning Show";
        case 2: return "Matinee Show";
        case 3: return "Afternoon Show";
        case 4: return "Evening Show";
        case 5: return "Night Show";
        default: return "Unknown Show";
    }
}

void getShowTime(int show, char *timeStr) {
    switch(show) {
        case 1: strcpy(timeStr, "09:00 AM"); break;
        case 2: strcpy(timeStr, "12:00 PM"); break;
        case 3: strcpy(timeStr, "03:00 PM"); break;
        case 4: strcpy(timeStr, "06:00 PM"); break;
        case 5: strcpy(timeStr, "09:00 PM"); break;
        default: strcpy(timeStr, "Unknown");
    }
}

int generateShowID(int movieCode, int year, int month, int day, int show) {
    return (movieCode * 100000) + (year * 10000) + (month * 100) + (day * 10) + show;
}

int isShowDuplicate(int movieCode, int year, int month, int day, int show, Movie movies[], int count) {
    int i;
    for (i = 0; i < count; i++) {
        if (movies[i].moviecode == movieCode &&
            movies[i].year == year &&
            movies[i].month == month &&
            movies[i].day == day &&
            movies[i].show == show &&
            movies[i].moviestatus == 1) {
            return 1;
        }
    }
    return 0;
}

void displayShowTimings(void) {
    printf("\n+------------------------------------------------+\n");
