/* ---------- AUTHENTICATION FUNCTIONS ---------- */

void getHiddenInput(char *buffer, int maxLen) {
    int i = 0;
    int ch;

#ifdef _WIN32
    while (1) {
        ch = _getch();
        if (ch == '\r' || ch == '\n') {
            break;
        } else if (ch == '\b') {
            if (i > 0) {
                i--;
                printf("\b \b");
            }
        } else if (i < maxLen - 1 && ch >= 32 && ch <= 126) {
            buffer[i++] = (char)ch;
            printf("*");
        }
    }
#else
    struct termios oldAttr, newAttr;
    tcgetattr(STDIN_FILENO, &oldAttr);
    newAttr = oldAttr;
    newAttr.c_lflag &= ~(ICANON | ECHO);
    tcsetattr(STDIN_FILENO, TCSANOW, &newAttr);

    while (1) {
        ch = getchar();
        if (ch == '\n' || ch == '\r' || ch == EOF) {
            break;
        } else if (ch == 127 || ch == '\b') {
            if (i > 0) {
                i--;
                printf("\b \b");
                fflush(stdout);
            }
        } else if (i < maxLen - 1 && ch >= 32 && ch <= 126) {
            buffer[i++] = (char)ch;
            printf("*");
            fflush(stdout);
        }
    }

    tcsetattr(STDIN_FILENO, TCSANOW, &oldAttr);
#endif

    buffer[i] = '\0';
    printf("\n");
}

int adminLogin(void) {
    char username[MAX_NAME_LEN];
    char password[MAX_NAME_LEN];
    int attempts = MAX_LOGIN_ATTEMPTS;

    while (attempts > 0) {
        clearScreen();
        displayHeader("ADMIN PANEL LOGIN");

        printf("Username: ");
        if (scanf(" %49[^\n]", username) != 1) {
            while (getchar() != '\n');
            continue;
        }
        while (getchar() != '\n');

        printf("Password: ");
        getHiddenInput(password, MAX_NAME_LEN);

        if (strcmp(username, ADMIN_USERNAME) == 0 && strcmp(password, ADMIN_PASSWORD) == 0) {
            printf("\nLogin successful! Welcome, Admin.\n");
            pressAnyKey();
            return 1;
        }

        attempts--;
        printf("\nInvalid username or password! Attempts remaining: %d\n", attempts);
        pressAnyKey();
    }

    printf("\nToo many failed attempts. Access denied.\n");
    pressAnyKey();
    return 0;
}

